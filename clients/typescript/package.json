{
  "name": "@loomhelm/multi-task-flow",
  "version": "0.2.5",
  "description": "Versioned Bun CLI and complete Multi-task Flow Skill runtime for Loomhelm",
  "type": "module",
  "engines": {
    "bun": "1.4.4"
  },
  "bin": {
    "multi-task-flow": "src/cli.ts",
    "loomhelm": "src/cli.ts"
  },
  "files": [
    "src",
    "toolkit",
    "README.md",
    "config.example.json",
    "bun.lock",
    "package.json"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "types": "src/index.ts",
  "scripts": {
    "build": "bun ../../skills/multi-task-flow/scripts/package-client-skills.ts --require-dependencies",
    "check": "bun x --no-install tsc -p tsconfig.json --noEmit",
    "test": "bun run build && bun test test/*.test.ts",
    "pack:check": "bun run build && bun pm pack --dry-run",
    "publish:exact": "bun --no-install src/cli.ts release publish --dist-tag \"$npm_package_version\"",
    "publish:compat": "bun --no-install src/cli.ts release publish --dist-tag \"${npm_config_compat_tag:?set npm_config_compat_tag=compat-vN}\""
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/bun": "1.4.4"
  },
  "dependencies": {
    "@xyflow/react": "12.12.1",
    "elkjs": "0.12.1",
    "lucide": "1.65.0",
    "moment": "2.31.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "vis-data": "8.0.6",
    "vis-timeline": "8.5.6",
    "zod": "4.6.7"
  },
  "loomhelm": {
    "compatibilityLine": "compat-v1",
    "skillVersion": "2.7.5",
    "contracts": {
      "ledger": 3,
      "api": 1,
      "frontend": 1,
      "viewer": 5,
      "service": "1"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.4"
}
