{
  "schema_version": 1,
  "policy": {
    "baseline_policy": "explicit-waiver-required",
    "require_signed_commits": true,
    "branch_protection": {
      "protected_branches": [
        "main"
      ],
      "require_pull_request": true,
      "disallow_direct_pushes": true
    }
  },
  "required_checks": [
    "Quality Gates",
    "Bootstrap Verification",
    "React Doctor",
    "Repository Verification",
    "Candidate Build",
    "Blue-Green Control Contract",
    "TypeScript Client (Bun)",
    "Product Release Contract",
    "Product Package (ubuntu-24.04)",
    "Product Package (macos-15)"
  ],
  "informational_checks": [
    "Candidate Reproducibility",
    "Skills Native macOS",
    "Go Race Tests",
    "Go Shuffle Tests"
  ],
  "waivers": [],
  "expected_pr_workflows": [
    {
      "workflow": "Candidate CI",
      "jobs": [
        "Quality Gates",
        "Bootstrap Verification",
        "React Doctor",
        "Repository Verification",
        "Go Race Tests",
        "Go Shuffle Tests",
        "Candidate Build",
        "Skills Native macOS",
        "Candidate Reproducibility",
        "TypeScript Client (Bun)",
        "Product Release Contract",
        "Product Package (ubuntu-24.04)",
        "Product Package (macos-15)"
      ]
    },
    {
      "workflow": "Blue-Green Baseline",
      "jobs": [
        "Blue-Green Control Contract"
      ]
    }
  ]
}
