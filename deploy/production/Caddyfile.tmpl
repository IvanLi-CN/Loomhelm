{
	admin {$LOOMHELM_CADDY_CONTROL_IP}:2019 {
		origins caddy-control:2019
	}
	auto_https off
}

:80 {
	encode gzip

	handle /api/v1/deployment {
		reverse_proxy deployment-controller:8090
	}
	handle /api/v1/deployment/* {
		reverse_proxy deployment-controller:8090
	}
	handle /api/* {
		reverse_proxy server-__ACTIVE_SLOT__:8080
	}
	handle /mcp {
		reverse_proxy server-__ACTIVE_SLOT__:8080
	}
	handle /gateway {
		reverse_proxy server-__ACTIVE_SLOT__:8080
	}
	handle /livez {
		reverse_proxy server-__ACTIVE_SLOT__:8080
	}
	handle /readyz {
		reverse_proxy server-__ACTIVE_SLOT__:8080
	}
	handle /version {
		reverse_proxy server-__ACTIVE_SLOT__:8080
	}
	handle /-/drain {
		reverse_proxy server-__ACTIVE_SLOT__:8080
	}

	handle {
		root * /srv/web
		try_files {path} __ACTIVE_CANDIDATE__{path} __RETAINED_PATHS__ __ACTIVE_CANDIDATE__/index.html
		file_server
	}
}
