# Copy to an installation-owned protected env file. Never commit real values.
LOOMHELM_CADDY_IMAGE=caddy:2.10-alpine@sha256:replace-with-immutable-digest
LOOMHELM_CONTROLLER_IMAGE=ghcr.io/example/loomhelm-controller@sha256:replace-with-immutable-digest
LOOMHELM_CONTROLLER_VERSION=replace-with-controller-version
LOOMHELM_DATABASE_URL=postgres://user:password@postgres:5432/loomhelm?sslmode=disable
LOOMHELM_COMPOSE_PROJECT=loomhelm
LOOMHELM_DEPLOYMENT_OWNER_USER_IDS=replace-with-user-id
LOOMHELM_DOCKER_GID=replace-with-host-docker-group-id
LOOMHELM_CONTROL_SUBNET=172.31.240.0/28
LOOMHELM_CONTROL_DYNAMIC_SUBNET=172.31.240.8/29
LOOMHELM_CONTROLLER_CONTROL_IP=172.31.240.3
LOOMHELM_CADDY_ADMIN_SUBNET=172.31.241.0/28
LOOMHELM_CADDY_ADMIN_IP=172.31.241.2
LOOMHELM_CONTROLLER_ADMIN_IP=172.31.241.3
LOOMHELM_HTTP_PORT=18080
LOOMHELM_CADDY_CONFIG_DIR=/srv/loomhelm/config/caddy
LOOMHELM_INSTALLATION_ROOT=/srv/loomhelm
LOOMHELM_DEPLOYMENT_ENV_FILE=/srv/loomhelm/.env.production
LOOMHELM_DEPLOYMENT_BLUE_URL=http://server-blue:8080
LOOMHELM_DEPLOYMENT_GREEN_URL=http://server-green:8080
LOOMHELM_DEPLOYMENT_BLUE_WORKER_URL=http://worker-blue:8081
LOOMHELM_DEPLOYMENT_GREEN_WORKER_URL=http://worker-green:8081
LOOMHELM_WEB_ROOT=/srv/loomhelm/web
LOOMHELM_DEPLOYMENT_STATE_DIR=/srv/loomhelm/deployment
LOOMHELM_ARTIFACT_ROOT=/srv/loomhelm/artifacts
LOOMHELM_DRAIN_TOKEN=replace-with-random-secret
LOOMHELM_DEPLOYMENT_DRAIN_TIMEOUT=30s
LOOMHELM_WORKER_LEASE_KEY=loomhelm-worker
LOOMHELM_SESSION_COOKIE_SECURE=true

LOOMHELM_CONNECTOR_IMAGE=ghcr.io/example/loomhelm-connector@sha256:replace-with-immutable-digest
LOOMHELM_CONNECTOR_VERSION=replace-with-connector-version
LOOMHELM_CONNECTOR_SERVER_URL=https://loomhelm.example.test
LOOMHELM_CONNECTOR_HOST_ID=replace-with-host-id
LOOMHELM_CONNECTOR_TOKEN=replace-with-connector-token
LOOMHELM_CONNECTOR_JOURNAL_ROOT=/srv/loomhelm/connector
LOOMHELM_CONNECTOR_WORKSPACE_ROOT=/srv/loomhelm/workspace

# These values are installed from one immutable candidate at a time.
LOOMHELM_BLUE_SERVER_IMAGE=ghcr.io/example/loomhelm-server@sha256:replace-with-digest
LOOMHELM_BLUE_WORKER_IMAGE=ghcr.io/example/loomhelm-worker@sha256:replace-with-digest
LOOMHELM_BLUE_SOURCE_SHA=replace-with-full-sha
LOOMHELM_BLUE_ARTIFACT_DIGEST=sha256:replace-with-digest
LOOMHELM_BLUE_WORKER_GENERATION=1
LOOMHELM_GREEN_SERVER_IMAGE=ghcr.io/example/loomhelm-server@sha256:replace-with-digest
LOOMHELM_GREEN_WORKER_IMAGE=ghcr.io/example/loomhelm-worker@sha256:replace-with-digest
LOOMHELM_GREEN_SOURCE_SHA=replace-with-full-sha
LOOMHELM_GREEN_ARTIFACT_DIGEST=sha256:replace-with-digest
LOOMHELM_GREEN_WORKER_GENERATION=2
