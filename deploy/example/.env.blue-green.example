# Copy this file to a private deployment-host env file and replace every
# placeholder. It is consumed by scripts/preview, not committed state.

LOOMHELM_PREVIEW_PROJECT_NAME=loomhelm-preview-example
LOOMHELM_DATABASE_VOLUME_NAME=loomhelm-example-postgres
LOOMHELM_ARTIFACT_VOLUME_NAME=loomhelm-example-artifacts
LOOMHELM_PREVIEW_STATE_DIR=/var/lib/loomhelm/preview-state
LOOMHELM_DATABASE_NETWORK=loomhelm-example-database
LOOMHELM_DATABASE_NETWORK_EXTERNAL=true

# These ports are loopback health/debug endpoints. Traefik uses the proxy
# network and the Caddy service's internal port 80 as the stable entry.
LOOMHELM_PREVIEW_HTTP_PORT=18080
LOOMHELM_PREVIEW_ADMIN_PORT=18081
LOOMHELM_BLUE_SERVER_PORT=18082
LOOMHELM_GREEN_SERVER_PORT=18083

# The preview Compose file expects PostgreSQL and its durable state outside
# the retiring application slots. Set this to the reachable database target.
LOOMHELM_DATABASE_URL=postgres://loomhelm:replace-with-url-safe-password@postgres:5432/loomhelm?sslmode=disable
LOOMHELM_POSTGRES_PORT=5432
LOOMHELM_DRAIN_TOKEN=replace-with-a-private-drain-token
LOOMHELM_DATABASE_MIN_CONNS=0
LOOMHELM_DATABASE_MAX_CONNS=4
LOOMHELM_WORKER_LEASE_KEY=loomhelm-worker

# Traefik must already own this external network when the flag is true.
LOOMHELM_PROXY_NETWORK=loomhelm-proxy
LOOMHELM_PROXY_NETWORK_EXTERNAL=true
LOOMHELM_TRAEFIK_ENABLED=true
LOOMHELM_TRAEFIK_ENTRYPOINTS=websecure
LOOMHELM_TRAEFIK_TLS=true
LOOMHELM_TRAEFIK_MIDDLEWARE=
LOOMHELM_PUBLIC_HOST=loomhelm.example.test

# Server-only OIDC. Leave empty only when login is intentionally disabled.
LOOMHELM_OIDC_ISSUER_URL=
LOOMHELM_OIDC_CLIENT_ID=
LOOMHELM_OIDC_CLIENT_SECRET=
LOOMHELM_OIDC_REDIRECT_URL=
LOOMHELM_SESSION_COOKIE_SECURE=true
