{
	auto_https off
}

:80 {
	encode gzip

	handle /api/* {
		reverse_proxy server:8080
	}
	handle /mcp {
		reverse_proxy server:8080
	}
	handle /gateway {
		reverse_proxy server:8080
	}
	handle /livez {
		reverse_proxy server:8080
	}
	handle /readyz {
		reverse_proxy server:8080
	}
	handle /version {
		reverse_proxy server:8080
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
