# Copy this file to deploy/example/.env and replace every placeholder before use.
# The copied .env is ignored by Git; keep it private on the deployment host.

LOOMHELM_COMPOSE_PROJECT_NAME=loomhelm-example
LOOMHELM_APP_NETWORK=loomhelm-example
LOOMHELM_PROXY_NETWORK=loomhelm-proxy
LOOMHELM_PROXY_NETWORK_EXTERNAL=false

# Set true only when an existing Traefik network with this name is present.
LOOMHELM_TRAEFIK_ENABLED=false
LOOMHELM_TRAEFIK_ENTRYPOINTS=websecure
LOOMHELM_TRAEFIK_TLS=true
LOOMHELM_TRAEFIK_MIDDLEWARE=
LOOMHELM_PUBLIC_HOST=loomhelm.example.test

# This loopback binding is for direct checks. Traefik uses the proxy network.
LOOMHELM_HTTP_BIND=127.0.0.1
LOOMHELM_HTTP_PORT=18080

LOOMHELM_POSTGRES_IMAGE=postgres:17-alpine
LOOMHELM_POSTGRES_DB=loomhelm
LOOMHELM_POSTGRES_USER=loomhelm
LOOMHELM_POSTGRES_PASSWORD=replace-with-url-safe-password
LOOMHELM_POSTGRES_PORT=5432
LOOMHELM_DATABASE_URL=postgres://loomhelm:replace-with-url-safe-password@postgres:5432/loomhelm?sslmode=disable
LOOMHELM_DATABASE_MIN_CONNS=0
LOOMHELM_DATABASE_MAX_CONNS=4
LOOMHELM_DATABASE_VOLUME_NAME=loomhelm-example-postgres
LOOMHELM_ARTIFACT_VOLUME_NAME=loomhelm-example-artifacts

LOOMHELM_SERVER_IMAGE=loomhelm-server:example
LOOMHELM_WORKER_IMAGE=loomhelm-worker:example
LOOMHELM_WEB_IMAGE=loomhelm-web:example
LOOMHELM_VERSION=example
LOOMHELM_CANDIDATE_SOURCE_SHA=example
LOOMHELM_ARTIFACT_DIGEST=example
LOOMHELM_DRAIN_TOKEN=replace-with-a-private-drain-token
LOOMHELM_SHUTDOWN_TIMEOUT=10s
LOOMHELM_STOP_GRACE_PERIOD=90s
LOOMHELM_STARTUP_TIMEOUT=10m
LOOMHELM_WORKER_GENERATION=1
LOOMHELM_WORKER_LEASE_KEY=loomhelm-worker

# Leave browser login disabled for a local smoke test. Configure all three
# required OIDC values together on the deployment host.
LOOMHELM_OIDC_ISSUER_URL=
LOOMHELM_OIDC_CLIENT_ID=
LOOMHELM_OIDC_CLIENT_SECRET=
LOOMHELM_OIDC_REDIRECT_URL=
LOOMHELM_SESSION_COOKIE_SECURE=true
