    "CommandState": {
      "type": "string",
      "enum": ["accepted", "executing", "succeeded", "failed", "unknown", "rejected"]
    },
    "EventSource": {
      "type": "string",
      "enum": ["app-server", "host-observation", "artifact"]
    },
    "EventType": {
      "type": "string",
