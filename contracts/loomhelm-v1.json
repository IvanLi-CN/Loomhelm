{
  "schema": "loomhelm.public-contract/v1",
  "version": "v1",
  "types": {
    "JSONValue": {
      "kind": "json-value"
    },
    "TaskStatus": {
      "type": "string",
      "enum": ["todo", "in_progress", "blocked", "done", "cancelled"]
    },
    "SessionPath": {
      "type": "string",
      "enum": ["new", "existing_active"]
    },
    "SessionState": {
      "type": "string",
      "enum": ["starting", "active", "reconciling", "disconnected", "closed", "unsupported"]
    },
    "RunStatus": {
      "type": "string",
      "enum": ["pending", "running", "waiting_approval", "completed", "failed", "interrupted", "unknown"]
    },
    "ApprovalStatus": {
      "type": "string",
      "enum": ["pending", "approved", "denied", "expired"]
    },
    "ApprovalDecision": {
      "type": "string",
      "enum": ["approve", "deny"]
    },
    "CommandKind": {
      "type": "string",
      "enum": ["session.start", "session.attach", "run.send", "run.approve", "run.deny", "run.interrupt"]
    },
    "CommandState": {
      "type": "string",
      "enum": ["accepted", "executing", "succeeded", "failed", "unknown", "rejected"]
    },
    "EventSource": {
      "type": "string",
      "enum": ["app-server", "host-observation", "artifact"]
    },
    "EventType": {
      "type": "string",
      "enum": [
        "session.created",
        "session.attached",
        "run.started",
        "message.delta",
        "item.started",
        "item.completed",
        "approval.requested",
        "approval.resolved",
        "run.interrupted",
        "run.completed",
        "run.failed",
        "artifact.created",
        "reconciliation.required",
        "reconciliation.completed",
        "unknown"
      ]
    },
    "ArtifactKind": {
      "type": "string",
      "enum": ["file", "diff", "snapshot"]
    },
    "ReconciliationState": {
      "type": "string",
      "enum": ["confirmed", "not_found", "unknown"]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "invalid_request",
        "unauthorized",
        "not_found",
        "conflict",
        "unsupported_path",
        "idempotency_conflict",
        "unknown_result",
        "cursor_expired"
      ]
    },
    "Project": {
      "type": "object",
      "required": ["id", "name", "created_at", "updated_at"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "Task": {
      "type": "object",
      "required": ["id", "project_id", "title", "goal", "status", "created_at", "updated_at"],
      "properties": {
        "id": {"type": "string"},
        "project_id": {"type": "string"},
        "title": {"type": "string"},
        "goal": {"type": "string"},
        "status": {"$ref": "#/types/TaskStatus"},
        "session_id": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "Session": {
      "type": "object",
      "required": ["id", "path", "state", "external_thread_ref", "created_at", "updated_at"],
      "properties": {
        "id": {"type": "string"},
        "project_id": {"type": "string"},
        "task_id": {"type": "string"},
        "path": {"$ref": "#/types/SessionPath"},
        "state": {"$ref": "#/types/SessionState"},
        "external_thread_ref": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "Run": {
      "type": "object",
      "required": ["id", "session_id", "status", "created_at"],
      "properties": {
        "id": {"type": "string"},
        "session_id": {"type": "string"},
        "status": {"$ref": "#/types/RunStatus"},
        "command_id": {"type": "string"},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "last_cursor": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "Approval": {
      "type": "object",
      "required": ["id", "run_id", "revision", "kind", "summary", "status", "requested_at"],
      "properties": {
        "id": {"type": "string"},
        "run_id": {"type": "string"},
        "revision": {"type": "integer", "format": "int64"},
        "kind": {"type": "string"},
        "summary": {"type": "string"},
        "status": {"$ref": "#/types/ApprovalStatus"},
        "requested_at": {"type": "string", "format": "date-time"}
      }
    },
    "Artifact": {
      "type": "object",
      "required": ["id", "session_id", "name", "kind", "size", "sha256", "content_type", "created_at"],
      "properties": {
        "id": {"type": "string"},
        "session_id": {"type": "string"},
        "run_id": {"type": "string"},
        "name": {"type": "string"},
        "kind": {"$ref": "#/types/ArtifactKind"},
        "size": {"type": "integer", "format": "int64"},
        "sha256": {"type": "string"},
        "content_type": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "ApiError": {
      "type": "object",
      "required": ["code", "message", "request_id"],
      "properties": {
        "code": {"$ref": "#/types/ErrorCode"},
        "message": {"type": "string"},
        "request_id": {"type": "string"},
        "details": {"kind": "raw-json"}
      }
    },
    "Command": {
      "type": "object",
      "required": ["command_id", "kind", "session_id", "issued_at", "payload"],
      "properties": {
        "command_id": {"type": "string"},
        "kind": {"$ref": "#/types/CommandKind"},
        "session_id": {"type": "string"},
        "run_id": {"type": "string"},
        "issued_at": {"type": "string", "format": "date-time"},
        "payload": {"kind": "raw-json"}
      }
    },
    "CommandAck": {
      "type": "object",
      "required": ["command_id", "state", "received_at", "deduplicated"],
      "properties": {
        "command_id": {"type": "string"},
        "state": {"$ref": "#/types/CommandState"},
        "received_at": {"type": "string", "format": "date-time"},
        "operation_id": {"type": "string"},
        "run_id": {"type": "string"},
        "event_cursor": {"type": "string"},
        "deduplicated": {"type": "boolean"},
        "result": {"kind": "raw-json"},
        "error": {"$ref": "#/types/ApiError"}
      }
    },
    "Event": {
      "type": "object",
      "required": ["event_id", "cursor", "sequence", "session_id", "type", "occurred_at", "source", "payload"],
      "properties": {
        "event_id": {"type": "string"},
        "cursor": {"type": "string"},
        "sequence": {"type": "integer", "format": "int64"},
        "session_id": {"type": "string"},
        "run_id": {"type": "string"},
        "type": {"$ref": "#/types/EventType"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "source": {"$ref": "#/types/EventSource"},
        "payload": {"kind": "raw-json"}
      }
    },
    "EventPage": {
      "type": "object",
      "required": ["events", "has_more"],
      "properties": {
        "events": {"type": "array", "items": {"$ref": "#/types/Event"}},
        "next_cursor": {"type": "string"},
        "has_more": {"type": "boolean"}
      }
    },
    "Reconciliation": {
      "type": "object",
      "required": ["command_id", "state", "observed_at"],
      "properties": {
        "command_id": {"type": "string"},
        "state": {"$ref": "#/types/ReconciliationState"},
        "observed_at": {"type": "string", "format": "date-time"},
        "event_cursor": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "FixtureEnvelope": {
      "type": "object",
      "required": ["schema", "source", "stream", "sequence", "payload"],
      "properties": {
        "schema": {"type": "string"},
        "source": {"type": "string"},
        "stream": {"$ref": "#/types/EventSource"},
        "sequence": {"type": "integer", "format": "int64"},
        "payload": {"kind": "raw-json"}
      }
    },
    "ProjectResponse": {
      "type": "object",
      "required": ["project"],
      "properties": {"project": {"$ref": "#/types/Project"}}
    },
    "ProjectListResponse": {
      "type": "object",
      "required": ["items", "has_more"],
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/types/Project"}},
        "next_cursor": {"type": "string"},
        "has_more": {"type": "boolean"}
      }
    },
    "TaskResponse": {
      "type": "object",
      "required": ["task"],
      "properties": {"task": {"$ref": "#/types/Task"}}
    },
    "TaskListResponse": {
      "type": "object",
      "required": ["items", "has_more"],
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/types/Task"}},
        "next_cursor": {"type": "string"},
        "has_more": {"type": "boolean"}
      }
    },
    "SessionResponse": {
      "type": "object",
      "required": ["session"],
      "properties": {"session": {"$ref": "#/types/Session"}}
    },
    "CommandAckResponse": {
      "type": "object",
      "required": ["ack"],
      "properties": {"ack": {"$ref": "#/types/CommandAck"}}
    },
    "ArtifactResponse": {
      "type": "object",
      "required": ["artifact"],
      "properties": {"artifact": {"$ref": "#/types/Artifact"}}
    },
    "CreateProjectRequest": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "description": {"type": "string"}
      }
    },
    "ListProjectsQuery": {
      "type": "object",
      "properties": {
        "after_cursor": {"type": "string"},
        "limit": {"type": "integer", "format": "int64"}
      }
    },
    "CreateTaskRequest": {
      "type": "object",
      "required": ["project_id", "title", "goal"],
      "properties": {
        "project_id": {"type": "string"},
        "title": {"type": "string"},
        "goal": {"type": "string"},
        "status": {"$ref": "#/types/TaskStatus"}
      }
    },
    "ListTasksQuery": {
      "type": "object",
      "properties": {
        "project_id": {"type": "string"},
        "after_cursor": {"type": "string"},
        "limit": {"type": "integer", "format": "int64"}
      }
    },
    "UpdateTaskRequest": {
      "type": "object",
      "properties": {
        "title": {"type": "string"},
        "goal": {"type": "string"},
        "status": {"$ref": "#/types/TaskStatus"}
      }
    },
    "CreateSessionRequest": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {"$ref": "#/types/SessionPath"},
        "project_id": {"type": "string"},
        "task_id": {"type": "string"},
        "prompt": {"type": "string"},
        "active_thread_ref": {"type": "string"}
      }
    },
    "SubmitRunRequest": {
      "type": "object",
      "required": ["command_id", "prompt"],
      "properties": {
        "command_id": {"type": "string"},
        "prompt": {"type": "string"},
        "model": {"type": "string"},
        "reasoning_effort": {"type": "string"}
      }
    },
    "ResolveApprovalRequest": {
      "type": "object",
      "required": ["command_id", "revision", "decision"],
      "properties": {
        "command_id": {"type": "string"},
        "revision": {"type": "integer", "format": "int64"},
        "decision": {"$ref": "#/types/ApprovalDecision"}
      }
    },
    "InterruptRunRequest": {
      "type": "object",
      "required": ["command_id"],
      "properties": {
        "command_id": {"type": "string"},
        "reason": {"type": "string"}
      }
    },
    "ListRunEventsQuery": {
      "type": "object",
      "properties": {
        "after_cursor": {"type": "string"},
        "limit": {"type": "integer", "format": "int64"}
      }
    }
  },
  "rest": {
    "base_path": "/api/v1",
    "operations": [
      {
        "operation_id": "listProjects",
        "method": "GET",
        "path": "/projects",
        "query_type": "ListProjectsQuery",
        "response_type": "ProjectListResponse",
        "summary": "List authorized projects",
        "mcp_tool": {"name": "loomhelm.list_projects", "description": "List projects visible to the caller."}
      },
      {
        "operation_id": "createProject",
        "method": "POST",
        "path": "/projects",
        "body_type": "CreateProjectRequest",
        "response_type": "ProjectResponse",
        "summary": "Create a project",
        "mcp_tool": {"name": "loomhelm.create_project", "description": "Create a project for authorized work."}
      },
      {
        "operation_id": "listTasks",
        "method": "GET",
        "path": "/tasks",
        "query_type": "ListTasksQuery",
        "response_type": "TaskListResponse",
        "summary": "List authorized tasks",
        "mcp_tool": {"name": "loomhelm.list_tasks", "description": "List tasks visible to the caller."}
      },
      {
        "operation_id": "createTask",
        "method": "POST",
        "path": "/tasks",
        "body_type": "CreateTaskRequest",
        "response_type": "TaskResponse",
        "summary": "Create a task",
        "mcp_tool": {"name": "loomhelm.create_task", "description": "Create a task in an authorized project."}
      },
      {
        "operation_id": "updateTask",
        "method": "PATCH",
        "path": "/tasks/{task_id}",
        "path_params": {"task_id": "string"},
        "body_type": "UpdateTaskRequest",
        "response_type": "TaskResponse",
        "summary": "Update a task",
        "mcp_tool": {"name": "loomhelm.update_task", "description": "Update an authorized task."}
      },
      {
        "operation_id": "createSession",
        "method": "POST",
        "path": "/sessions",
        "body_type": "CreateSessionRequest",
        "response_type": "SessionResponse",
        "summary": "Start a new or explicitly attach an active session",
        "mcp_tool": {"name": "loomhelm.start_session", "description": "Start a new Host Gateway session or request an explicit active-session attach."}
      },
      {
        "operation_id": "getSession",
        "method": "GET",
        "path": "/sessions/{session_id}",
        "path_params": {"session_id": "string"},
        "response_type": "SessionResponse",
        "summary": "Read a session",
        "mcp_tool": {"name": "loomhelm.get_session", "description": "Read an authorized session."}
      },
      {
        "operation_id": "submitRun",
        "method": "POST",
        "path": "/sessions/{session_id}/runs",
        "path_params": {"session_id": "string"},
        "body_type": "SubmitRunRequest",
        "response_type": "CommandAckResponse",
        "summary": "Submit a run command",
        "mcp_tool": {"name": "loomhelm.submit_run", "description": "Submit one idempotent run command."}
      },
      {
        "operation_id": "resolveApproval",
        "method": "POST",
        "path": "/runs/{run_id}/approvals/{approval_id}",
        "path_params": {"run_id": "string", "approval_id": "string"},
        "body_type": "ResolveApprovalRequest",
        "response_type": "CommandAckResponse",
        "summary": "Approve or deny a pending request",
        "mcp_tool": {"name": "loomhelm.resolve_approval", "description": "Resolve one current approval revision exactly once."}
      },
      {
        "operation_id": "interruptRun",
        "method": "POST",
        "path": "/runs/{run_id}/interrupt",
        "path_params": {"run_id": "string"},
        "body_type": "InterruptRunRequest",
        "response_type": "CommandAckResponse",
        "summary": "Interrupt a run",
        "mcp_tool": {"name": "loomhelm.interrupt_run", "description": "Request an idempotent run interruption."}
      },
      {
        "operation_id": "listRunEvents",
        "method": "GET",
        "path": "/runs/{run_id}/events",
        "path_params": {"run_id": "string"},
        "query_type": "ListRunEventsQuery",
        "response_type": "EventPage",
        "summary": "Read ordered run events after a cursor",
        "mcp_tool": {"name": "loomhelm.read_run_events", "description": "Read ordered run events from an exclusive cursor."}
      },
      {
        "operation_id": "getArtifact",
        "method": "GET",
        "path": "/artifacts/{artifact_id}",
        "path_params": {"artifact_id": "string"},
        "response_type": "ArtifactResponse",
        "summary": "Read authorized artifact metadata",
        "mcp_tool": {"name": "loomhelm.get_artifact", "description": "Read authorized conversation artifact metadata."}
      }
    ]
  },
  "mcp": {
    "resources": [
      {"name": "session", "uri": "loomhelm://sessions/{session_id}", "operation_id": "getSession"},
      {"name": "run-events", "uri": "loomhelm://runs/{run_id}/events", "operation_id": "listRunEvents"},
      {"name": "artifact", "uri": "loomhelm://artifacts/{artifact_id}", "operation_id": "getArtifact"}
    ]
  }
}
