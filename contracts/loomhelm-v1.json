  "rest": {
    "base_path": "/api/v1",
    "operations": [
      {
        "operation_id": "getBrowserSession",
        "browser_only": true,
        "method": "GET",
        "path": "/auth/session",
        "response_type": "BrowserSessionResponse",
        "summary": "Read the authenticated browser identity and enforced CSRF protection"
      },
      {
        "operation_id": "logoutBrowserSession",
        "browser_only": true,
        "method": "POST",
        "path": "/auth/logout",
        "response_status": 204,
        "summary": "Destroy the current browser session behind same-origin CSRF protection"
      },
      {
        "operation_id": "listUserCredentials",
        "method": "GET",
        "path": "/credentials",
