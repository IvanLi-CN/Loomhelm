        "session.attached",
        "run.started",
        "message.delta",
        "item.started",
        "item.completed",
        "approval.requested",
        "approval.resolved",
        "run.interrupted",
        "run.completed",
        "run.failed",
        "artifact.created",
        "reconciliation.required",
