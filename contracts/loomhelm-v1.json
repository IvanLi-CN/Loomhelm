      "type": "string",
      "enum": ["todo", "in_progress", "blocked", "done", "cancelled"]
    },
    "ProjectMemberRole": {
      "type": "string",
      "enum": ["viewer", "operator", "owner"]
    },
    "ProjectMemberGrantRole": {
      "type": "string",
      "enum": ["viewer", "operator"]
    },
    "SessionPath": {
      "type": "string",
      "enum": ["new", "existing_active"]
