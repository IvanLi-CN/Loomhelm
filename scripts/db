#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

command=${1:-}
case "$command" in
	migrate)
		exec go run ./internal/platform/database/cmd/migrate
		;;
	test)
		exec go test -count=1 ./internal/platform/database ./internal/platform/jobs ./internal/auth ./internal/projects ./internal/tasks ./internal/app
		;;
	*)
		echo "usage: scripts/db {migrate|test}" >&2
		exit 2
		;;
esac
