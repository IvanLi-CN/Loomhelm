#!/usr/bin/env python3
"""Run the pinned React Doctor against the staged or changed React files."""

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path


REACT_SUFFIXES = {".js", ".jsx", ".ts", ".tsx"}


def repository_root() -> Path:
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        raise RuntimeError(f"cannot resolve the Git repository root: {result.stderr.strip()}")
    return Path(result.stdout.strip()).resolve()


def run_git(root: Path, arguments: list[str]) -> list[str]:
    result = subprocess.run(
        ["git", *arguments],
        cwd=root,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        detail = result.stderr.decode("utf-8", errors="replace").strip()
        raise RuntimeError(f"Git file-range calculation failed: {detail or 'unknown Git error'}")
    return [item.decode("utf-8", errors="surrogateescape") for item in result.stdout.split(b"\0") if item]


def is_react_source(path: str) -> bool:
    candidate = Path(path)
    return (
        candidate.parts[:2] == ("web", "src")
        and candidate.suffix.lower() in REACT_SUFFIXES
    )


def changed_react_files(root: Path, staged: bool, base: str | None) -> list[str]:
    if staged:
        paths = run_git(
            root,
            ["diff", "--cached", "--name-only", "-z", "--diff-filter=ACMR", "--"],
        )
    else:
        resolved_base = base or os.environ.get("REACT_DOCTOR_BASE_REF") or "HEAD^"
        paths = run_git(
            root,
            ["diff", "--name-only", "-z", "--diff-filter=ACMR", f"{resolved_base}...HEAD", "--"],
        )
    return sorted({path for path in paths if is_react_source(path)})


def pinned_version(root: Path) -> str:
    versions_path = root / "tools" / "versions.env"
    try:
        lines = versions_path.read_text(encoding="utf-8").splitlines()
    except OSError as error:
        raise RuntimeError(f"cannot read the tool version manifest: {error}") from error
    for line in lines:
        key, separator, value = line.partition("=")
        if separator and key == "REACT_DOCTOR_VERSION" and value:
            return value.strip()
    raise RuntimeError("tools/versions.env is missing REACT_DOCTOR_VERSION")


def doctor_executable(root: Path) -> str:
    configured = os.environ.get("REACT_DOCTOR_BIN")
    candidates = [
        configured,
        str(root / "node_modules" / ".bin" / "react-doctor"),
        str(root / "web" / "node_modules" / ".bin" / "react-doctor"),
        shutil.which("react-doctor"),
    ]
    for candidate in candidates:
        if candidate and Path(candidate).is_file() and os.access(candidate, os.X_OK):
            return candidate
    raise RuntimeError(
        "the pinned React Doctor executable is unavailable; run `bun install --frozen-lockfile` "
        "before running this check"
    )


def doctor_version(executable: str, root: Path) -> str:
    result = subprocess.run(
        [executable, "--version"],
        cwd=root,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        raise RuntimeError(f"React Doctor version check failed: {detail or 'unknown error'}")
    return (result.stdout or result.stderr).strip().lstrip("v").splitlines()[0].strip()


def invoke_doctor(root: Path, executable: str, files: list[str], staged: bool) -> int:
    command = [
        executable,
        "--no-score",
        "--no-telemetry",
        "--no-supply-chain",
        "--no-color",
        "--blocking",
        "error",
        "--scope",
        "files",
    ]
    if staged:
        command.append("--staged")
    command.extend(files)
    print("React Doctor: scanning " + ", ".join(files), flush=True)
    result = subprocess.run(command, cwd=root, check=False)
    return result.returncode


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Run the pinned React Doctor for staged or base-to-HEAD React changes."
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--staged", action="store_true", help="scan staged React files")
    parser.add_argument("--base", help="Git base ref for a base-to-HEAD scan")
    args = parser.parse_args()

    try:
        root = repository_root()
        files = changed_react_files(root, staged=args.staged, base=args.base)
        if not files:
            scope = "staged" if args.staged else "base-to-HEAD"
            print(f"React Doctor: no changed React files in {scope} scope; skipped.")
            return 0
        expected = pinned_version(root)
        executable = doctor_executable(root)
        actual = doctor_version(executable, root)
        if actual != expected:
            raise RuntimeError(
                f"React Doctor version mismatch: expected {expected}, found {actual or 'unreadable'}"
            )
    except (OSError, RuntimeError) as error:
        print(f"React Doctor: {error}", file=sys.stderr)
        return 1

    status = invoke_doctor(root, executable, files, staged=args.staged)
    if status != 0:
        print(f"React Doctor: blocking diagnostic or tool failure (exit {status})", file=sys.stderr)
    return status


if __name__ == "__main__":
    raise SystemExit(main())
