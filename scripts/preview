#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
repo_root=$(git -C "$script_dir/.." rev-parse --show-toplevel 2>/dev/null) || {
	echo "preview: cannot resolve a Git worktree" >&2
	exit 1
}
repo_root=$(CDPATH= cd -- "$repo_root" && pwd -P)
cd "$repo_root"

control="$repo_root/deploy/preview/control.py"
state_dir=${LOOMHELM_PREVIEW_STATE_DIR:-$repo_root/.loomhelm-preview}
case "$state_dir" in
	/*) ;;
	*) state_dir="$repo_root/$state_dir" ;;
esac
state_dir=$(CDPATH= cd -- "$(dirname -- "$state_dir")" && pwd -P)/$(basename -- "$state_dir")
env_file="$state_dir/compose.env"
compose_project=${LOOMHELM_PREVIEW_PROJECT_NAME:-loomhelm-preview}

control() {
	python3 "$control" --state-dir "$state_dir" "$@"
}

compose() {
	docker compose --project-name "$compose_project" --env-file "$env_file" -f deploy/preview/compose.yaml "$@"
}

load_local_environment() {
	if [ -f .env.local ]; then
		set -a
		. ./.env.local
		set +a
	fi
}

refresh_env() {
	load_local_environment
	mkdir -p "$state_dir"
	control compose-env --output "$env_file" >/dev/null
}

server_port() {
	case "$1" in
		blue) printf '%s\n' "${LOOMHELM_BLUE_SERVER_PORT:-18081}" ;;
		green) printf '%s\n' "${LOOMHELM_GREEN_SERVER_PORT:-18082}" ;;
		*) echo "preview: invalid slot $1" >&2; return 2 ;;
	esac
}

wait_http_ready() {
	slot=$1
	port=$(server_port "$slot")
	deadline=$(( $(date +%s) + ${LOOMHELM_PREVIEW_READY_TIMEOUT:-90} ))
	while [ "$(date +%s)" -lt "$deadline" ]; do
		if curl --fail --silent --show-error "http://127.0.0.1:$port/readyz" >/dev/null 2>&1 &&
			curl --fail --silent --show-error "http://127.0.0.1:$port/version" >/dev/null 2>&1; then
			if docker compose --project-name "$compose_project" --env-file "$env_file" -f deploy/preview/compose.yaml exec -T "worker-$slot" wget -q -O - http://127.0.0.1:8081/readyz 2>/dev/null | grep -q '"ready":true'; then
				return 0
			fi
		fi
		sleep 2
	done
	echo "preview: slot $slot did not become ready" >&2
	return 1
}

drain_slot() {
	slot=$1
	load_local_environment
	if ! compose exec -T "server-$slot" /bin/busybox wget -q -O - \
		--header "Authorization: Bearer ${LOOMHELM_DRAIN_TOKEN:?LOOMHELM_DRAIN_TOKEN is required}" \
		--post-data '' http://127.0.0.1:8080/-/drain >/dev/null; then
		echo "preview: server $slot drain failed" >&2
		return 1
	fi
	if ! compose exec -T "worker-$slot" wget -q -O - \
		--header "Authorization: Bearer ${LOOMHELM_DRAIN_TOKEN:?LOOMHELM_DRAIN_TOKEN is required}" \
		--post-data '' http://127.0.0.1:8081/-/drain >/dev/null; then
		echo "preview: worker $slot drain failed" >&2
		return 1
	fi
}

promote_slot() {
	slot=$1
	wait_http_ready "$slot"
	control render --slot "$slot" --output "$state_dir/caddy/Caddyfile.next" >/dev/null
	if [ ! -f "$state_dir/caddy/Caddyfile" ]; then
		cp "$state_dir/caddy/Caddyfile.next" "$state_dir/caddy/Caddyfile"
	fi
	compose up -d caddy >/dev/null
	compose exec -T caddy caddy validate --config /etc/caddy/Caddyfile.next --adapter caddyfile >/dev/null
	compose exec -T caddy caddy reload --config /etc/caddy/Caddyfile.next --adapter caddyfile >/dev/null
	commit_output=$(control commit --slot "$slot")
	old_slot=$(printf '%s\n' "$commit_output" | sed -n 's/^old_slot=//p')
	refresh_env
	if [ -n "$old_slot" ]; then
		drain_slot "$old_slot"
		compose stop "server-$old_slot" "worker-$old_slot" >/dev/null
	fi
	printf '%s\n' "$commit_output"
}

usage() {
	cat <<'EOF'
usage: scripts/preview <command> [argument]

commands:
  init                         Create the local traceable preview state.
  stage <manifest.json>        Copy a candidate Web tree and start its inactive slot.
  promote [slot]               Reload Caddy after readiness and drain the old slot.
  rollback                     Restage the retained slot with a new Worker generation.
  drain <blue|green>           Drain one slot without changing traffic.
  check [manifest.json]        Check the declared two-way compatibility window.
  status                       Print the complete deployment state.
  compose-config               Validate the generated Compose configuration.
EOF
}

command=${1:-}
case "$command" in
	init)
		control init
		;;
	stage)
		manifest=${2:-}
		[ -n "$manifest" ] || { usage >&2; exit 2; }
		control stage --manifest "$manifest"
		refresh_env
		slot=$(control status --field pending_slot)
		compose up -d "server-$slot" "worker-$slot"
		wait_http_ready "$slot"
		printf 'staged_slot=%s\n' "$slot"
		;;
	promote)
		refresh_env
		slot=${2:-$(control status --field pending_slot)}
		[ -n "$slot" ] || { echo "preview: no pending slot" >&2; exit 2; }
		promote_slot "$slot"
		;;
	rollback)
		refresh_env
		slot=$(control status --field previous_slot)
		[ -n "$slot" ] || { echo "preview: no retained slot is available for rollback" >&2; exit 2; }
		control stage-existing --slot "$slot"
		refresh_env
		compose up -d "server-$slot" "worker-$slot"
		promote_slot "$slot"
		;;
	drain)
		slot=${2:-}
		[ -n "$slot" ] || { usage >&2; exit 2; }
		refresh_env
		drain_slot "$slot"
		;;
	check)
		refresh_env
		if [ -n "${2:-}" ]; then
			control check --manifest "$2"
		else
			control check
		fi
		compose config >/dev/null
		;;
	status)
		control status
		if [ -f "$env_file" ]; then
			compose ps
		fi
		;;
	compose-config)
		refresh_env
		compose config
		;;
	""|help|-h|--help)
		usage
		;;
	*)
		echo "preview: unknown command $command" >&2
		usage >&2
		exit 2
		;;
esac
