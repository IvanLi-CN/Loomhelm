#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
repo_root=$(git -C "$script_dir/.." rev-parse --show-toplevel 2>/dev/null) || {
	echo "preview: cannot resolve a Git worktree" >&2
	exit 1
}
repo_root=$(CDPATH= cd -- "$repo_root" && pwd -P)
cd "$repo_root"

control="$repo_root/deploy/preview/control.py"
state_dir=${LOOMHELM_PREVIEW_STATE_DIR:-$repo_root/.loomhelm-preview}
case "$state_dir" in
	/*) ;;
	*) state_dir="$repo_root/$state_dir" ;;
esac
state_dir=$(CDPATH= cd -- "$(dirname -- "$state_dir")" && pwd -P)/$(basename -- "$state_dir")
env_file="$state_dir/compose.env"
workflow_lock_pid=
workflow_lock_ready=

release_workflow_lock() {
	if [ -n "${workflow_lock_pid:-}" ]; then
		kill "$workflow_lock_pid" 2>/dev/null || true
		wait "$workflow_lock_pid" 2>/dev/null || true
		workflow_lock_pid=
	fi
	if [ -n "${workflow_lock_ready:-}" ]; then
		rm -f -- "$workflow_lock_ready"
		workflow_lock_ready=
	fi
	unset LOOMHELM_PREVIEW_WORKFLOW_LOCK_HELD
}

acquire_workflow_lock() {
	mkdir -p "$state_dir"
	workflow_lock_ready=$(mktemp "${TMPDIR:-/tmp}/loomhelm-preview-lock.XXXXXX")
	python3 - "$state_dir/.workflow.lock" "$workflow_lock_ready" "$$" <<'PY' &
import fcntl
import os
import pathlib
import sys
import time

lock_path = pathlib.Path(sys.argv[1])
ready_path = pathlib.Path(sys.argv[2])
parent_pid = int(sys.argv[3])
blocked_path = pathlib.Path(os.environ["LOOMHELM_PREVIEW_TEST_LOCK_BLOCKED_FILE"]) if os.environ.get("LOOMHELM_PREVIEW_TEST_LOCK_BLOCKED_FILE") else None
blocked_reported = False
lock_path.parent.mkdir(parents=True, exist_ok=True)
try:
    with lock_path.open("a+", encoding="utf-8") as handle:
        while True:
            if os.getppid() != parent_pid:
                raise SystemExit
            try:
                fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if blocked_path is not None and not blocked_reported:
                    blocked_path.write_text("blocked\n", encoding="utf-8")
                    blocked_reported = True
                time.sleep(0.25)
        ready_path.write_text("ready\n", encoding="utf-8")
        while os.getppid() == parent_pid:
            time.sleep(0.25)
finally:
    try:
        ready_path.unlink()
    except FileNotFoundError:
        pass
PY
	workflow_lock_pid=$!
	while [ ! -s "$workflow_lock_ready" ]; do
		if ! kill -0 "$workflow_lock_pid" 2>/dev/null; then
			echo "preview: workflow lock helper exited before acquiring the lock" >&2
			release_workflow_lock
			return 1
		fi
		sleep 0.01
	done
	export LOOMHELM_PREVIEW_WORKFLOW_LOCK_HELD=1
}

require_preview_settings() {
	: "${LOOMHELM_PREVIEW_PROJECT_NAME:?LOOMHELM_PREVIEW_PROJECT_NAME must be exported for this worktree}"
	: "${LOOMHELM_PREVIEW_HTTP_PORT:?LOOMHELM_PREVIEW_HTTP_PORT must be exported from a registered port lease}"
	: "${LOOMHELM_PREVIEW_ADMIN_PORT:?LOOMHELM_PREVIEW_ADMIN_PORT must be exported from a registered port lease}"
	: "${LOOMHELM_BLUE_SERVER_PORT:?LOOMHELM_BLUE_SERVER_PORT must be exported from a registered port lease}"
	: "${LOOMHELM_GREEN_SERVER_PORT:?LOOMHELM_GREEN_SERVER_PORT must be exported from a registered port lease}"
}

control() {
	python3 "$control" --state-dir "$state_dir" "$@"
}

compose() {
	require_preview_settings
	# compose.env contains derived candidate values, including the shutdown
	# grace lower bound; do not let a stale host export override that file.
	env -u LOOMHELM_STOP_GRACE_PERIOD docker compose --project-name "$LOOMHELM_PREVIEW_PROJECT_NAME" --env-file "$env_file" -f deploy/preview/compose.yaml "$@"
}

load_local_environment() {
	environment_file=${LOOMHELM_PREVIEW_ENV_FILE:-.env.local}
	if [ -f "$environment_file" ]; then
		set -a
		. "$environment_file"
		set +a
	fi
}

refresh_env() {
	load_local_environment
	require_preview_settings
	mkdir -p "$state_dir"
	control compose-env --output "$env_file" >/dev/null
}

server_port() {
	case "$1" in
		blue) printf '%s\n' "${LOOMHELM_BLUE_SERVER_PORT:?LOOMHELM_BLUE_SERVER_PORT is required}" ;;
		green) printf '%s\n' "${LOOMHELM_GREEN_SERVER_PORT:?LOOMHELM_GREEN_SERVER_PORT is required}" ;;
		*) echo "preview: invalid slot $1" >&2; return 2 ;;
	esac
}

identity_field() {
	control identity --slot "$1" --field "$2"
}

version_matches() {
	endpoint=$1
	expected_source=$2
	expected_digest=$3
	response=$(curl --fail --silent --show-error "$endpoint") || return 1
	printf '%s\n' "$response" | python3 -c '
import json
import sys

value = json.load(sys.stdin)
if value.get("version") != sys.argv[1] or value.get("candidate_source_sha") != sys.argv[1] or value.get("artifact_digest") != sys.argv[2]:
    raise SystemExit(1)
' "$expected_source" "$expected_digest"
}

worker_request() {
	compose exec -T "worker-$1" wget -q -O - "$2"
}

worker_version_matches() {
	slot=$1
	expected_source=$2
	expected_digest=$3
	response=$(worker_request "$slot" http://127.0.0.1:8081/version) || return 1
	printf '%s\n' "$response" | python3 -c '
import json
import sys

value = json.load(sys.stdin)
if value.get("version") != sys.argv[1] or value.get("candidate_source_sha") != sys.argv[1] or value.get("artifact_digest") != sys.argv[2]:
    raise SystemExit(1)
' "$expected_source" "$expected_digest"
}

verify_container_image() {
	service=$1
	expected=$2
	container=$(compose ps -q "$service")
	[ -n "$container" ] || { echo "preview: service $service has no container" >&2; return 1; }
	configured=$(docker inspect --format '{{.Config.Image}}' "$container")
	if [ "$configured" != "$expected" ]; then
		echo "preview: service $service image $configured does not match $expected" >&2
		return 1
	fi
	image_id=$(docker inspect --format '{{.Image}}' "$container")
	repo_digests=$(docker image inspect --format '{{json .RepoDigests}}' "$image_id")
	printf '%s\n' "$repo_digests" | python3 -c '
import json
import sys

expected = sys.argv[1]
digests = json.load(sys.stdin)
if expected not in digests:
    raise SystemExit(1)
' "$expected" || {
		echo "preview: service $service image repository digest does not match $expected" >&2
		return 1
	}
}

verify_candidate_identity() {
	slot=$1
	expected_source=$(identity_field "$slot" source_sha)
	expected_digest=$(identity_field "$slot" artifact_digest)
	verify_container_image "server-$slot" "$(identity_field "$slot" server_image)"
	verify_container_image "worker-$slot" "$(identity_field "$slot" worker_image)"
	control verify-web --slot "$slot" >/dev/null
	version_matches "http://127.0.0.1:$(server_port "$slot")/version" "$expected_source" "$expected_digest"
	worker_version_matches "$slot" "$expected_source" "$expected_digest"
}

wait_server_ready() {
	slot=$1
	port=$(server_port "$slot")
	deadline=$(( $(date +%s) + ${LOOMHELM_PREVIEW_READY_TIMEOUT:-660} ))
	while [ "$(date +%s)" -lt "$deadline" ]; do
		if curl --fail --silent --show-error "http://127.0.0.1:$port/readyz" >/dev/null 2>&1 &&
			version_matches "http://127.0.0.1:$port/version" "$(identity_field "$slot" source_sha)" "$(identity_field "$slot" artifact_digest)"; then
			return 0
		fi
		sleep 2
	done
	echo "preview: Server slot $slot did not become ready with the declared identity" >&2
	return 1
}

wait_worker_ready() {
	slot=$1
	deadline=$(( $(date +%s) + ${LOOMHELM_PREVIEW_READY_TIMEOUT:-660} ))
	while [ "$(date +%s)" -lt "$deadline" ]; do
		if worker_request "$slot" http://127.0.0.1:8081/readyz 2>/dev/null | grep -q '"ready":true' &&
			worker_version_matches "$slot" "$(identity_field "$slot" source_sha)" "$(identity_field "$slot" artifact_digest)"; then
			return 0
		fi
		sleep 2
	done
	echo "preview: Worker slot $slot did not become ready with the declared identity" >&2
	return 1
}

wait_http_ready() {
	wait_server_ready "$1" && wait_worker_ready "$1" && verify_candidate_identity "$1"
}

stage_failure() {
	slot=$1
	reason=$2
	compose stop "server-$slot" "worker-$slot" >/dev/null 2>&1 || true
	control abort-stage --slot "$slot" --reason "$reason" >/dev/null 2>&1 || true
	refresh_env >/dev/null 2>&1 || true
	active_slot=$(control status --field active_slot)
	if [ -n "$active_slot" ]; then
		if ! compose up -d --force-recreate "worker-$active_slot" >/dev/null 2>&1 || ! wait_worker_ready "$active_slot"; then
			echo "preview: failed candidate recovery also failed to restore Worker $active_slot" >&2
			return 1
		fi
	fi
	echo "preview: candidate slot $slot rejected: $reason" >&2
	return 1
}

start_staged_slot() {
	slot=$1
	if ! compose up -d --force-recreate "server-$slot" >/dev/null; then
		stage_failure "$slot" "Server container failed to start"
		return 1
	fi
	if ! verify_container_image "server-$slot" "$(identity_field "$slot" server_image)" || ! wait_server_ready "$slot" || ! control verify-web --slot "$slot" >/dev/null; then
		stage_failure "$slot" "candidate Server or Web identity/readiness check failed"
		return 1
	fi
	if ! compose up -d --force-recreate "worker-$slot" >/dev/null; then
		stage_failure "$slot" "Worker container failed to start"
		return 1
	fi
	if ! verify_container_image "worker-$slot" "$(identity_field "$slot" worker_image)" || ! wait_worker_ready "$slot" || ! verify_candidate_identity "$slot"; then
		stage_failure "$slot" "candidate Worker identity/readiness check failed"
		return 1
	fi
}

drain_slot() {
	slot=$1
	load_local_environment
	if ! compose exec -T "server-$slot" /bin/busybox wget -q -O - \
		--header "Authorization: Bearer ${LOOMHELM_DRAIN_TOKEN:?LOOMHELM_DRAIN_TOKEN is required}" \
		--post-data '' http://127.0.0.1:8080/-/drain >/dev/null; then
		echo "preview: server $slot drain failed" >&2
		return 1
	fi
	if ! compose exec -T "worker-$slot" wget -q -O - \
		--header "Authorization: Bearer ${LOOMHELM_DRAIN_TOKEN:?LOOMHELM_DRAIN_TOKEN is required}" \
		--post-data '' http://127.0.0.1:8081/-/drain >/dev/null; then
		echo "preview: worker $slot drain failed" >&2
		return 1
	fi
}

promote_slot() {
	slot=$1
	wait_http_ready "$slot"
	control render --slot "$slot" --output "$state_dir/caddy/Caddyfile.next" >/dev/null
	if [ ! -f "$state_dir/caddy/Caddyfile" ]; then
		cp "$state_dir/caddy/Caddyfile.next" "$state_dir/caddy/Caddyfile"
	fi
	compose up -d caddy >/dev/null
	compose exec -T caddy caddy validate --config /etc/caddy/Caddyfile.next --adapter caddyfile >/dev/null
	compose exec -T caddy caddy reload --config /etc/caddy/Caddyfile.next --adapter caddyfile >/dev/null
	commit_output=$(control commit --slot "$slot")
	old_slot=$(printf '%s\n' "$commit_output" | sed -n 's/^old_slot=//p')
	refresh_env
	if [ -n "$old_slot" ]; then
		drain_slot "$old_slot"
		compose stop "server-$old_slot" "worker-$old_slot" >/dev/null
	fi
	control verify-web --slot "$slot" >/dev/null
	printf '%s\n' "$commit_output"
}

usage() {
	cat <<'EOF'
usage: scripts/preview <command> [argument]

commands:
  init                         Create the local traceable preview state.
  stage <manifest.json>        Copy a candidate Web tree and start its inactive slot.
  promote [slot]               Reload Caddy after readiness and drain the old slot.
  rollback                     Restage the retained slot with a new Worker generation.
  drain <blue|green>           Drain one slot without changing traffic.
  check [manifest.json]        Check the declared two-way compatibility window.
  status                       Print the complete deployment state.
  compose-config               Validate the generated Compose configuration.
EOF
}

command=${1:-}
case "$command" in
	""|help|-h|--help) ;;
	*)
		trap 'release_workflow_lock' 0
		trap 'release_workflow_lock; exit 129' HUP
		trap 'release_workflow_lock; exit 130' INT
		trap 'release_workflow_lock; exit 143' TERM
		acquire_workflow_lock
		;;
esac
case "$command" in
	init)
		control init
		;;
	stage)
		manifest=${2:-}
		[ -n "$manifest" ] || { usage >&2; exit 2; }
		refresh_env
		control stage --manifest "$manifest"
		refresh_env
		slot=$(control status --field pending_slot)
		start_staged_slot "$slot"
		printf 'staged_slot=%s\n' "$slot"
		;;
	promote)
		refresh_env
		slot=${2:-$(control status --field pending_slot)}
		[ -n "$slot" ] || { echo "preview: no pending slot" >&2; exit 2; }
		promote_slot "$slot"
		;;
	rollback)
		refresh_env
		retained_key=${2:-$(control status --field previous_retained_key)}
		[ -n "$retained_key" ] || { echo "preview: no retained candidate is available for rollback" >&2; exit 2; }
		control stage-retained --retained-key "$retained_key"
		refresh_env
		slot=$(control status --field pending_slot)
		start_staged_slot "$slot"
		promote_slot "$slot"
		;;
	drain)
		slot=${2:-}
		[ -n "$slot" ] || { usage >&2; exit 2; }
		refresh_env
		drain_slot "$slot"
		;;
	check)
		refresh_env
		if [ -n "${2:-}" ]; then
			control check --manifest "$2"
		else
			control check
		fi
		compose config >/dev/null
		;;
	status)
		load_local_environment
		control validate-project >/dev/null
		control status
		if [ -f "$env_file" ]; then
			compose ps
		fi
		;;
	compose-config)
		refresh_env
		if [ -n "${LOOMHELM_PREVIEW_TEST_COMPOSE_CONFIG_OUTPUT:-}" ]; then
			# Test-only output keeps the normal command quiet while proving that
			# this wrapper's environment sanitization reaches Compose.
			compose config --format json >"$LOOMHELM_PREVIEW_TEST_COMPOSE_CONFIG_OUTPUT"
		else
			compose config --quiet
		fi
		;;
	""|help|-h|--help)
		usage
		;;
	*)
		echo "preview: unknown command $command" >&2
		usage >&2
		exit 2
		;;
esac
