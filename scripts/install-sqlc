#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
output_dir=${1:-}
if [ -z "$output_dir" ]; then
	echo "install-sqlc: an output directory is required" >&2
	exit 2
fi
mkdir -p "$output_dir"

expected_version=$(awk -F= '$1 == "SQLC_VERSION" { print $2; exit }' "$repo_root/tools/versions.env")
platform_key=""
case "$(uname -s):$(uname -m)" in
	Darwin:arm64) platform_key=darwin-arm64 ;;
	Darwin:x86_64) platform_key=darwin-x86_64 ;;
	Linux:aarch64|Linux:arm64) platform_key=linux-arm64 ;;
	Linux:x86_64|Linux:amd64) platform_key=linux-x86_64 ;;
	*) echo "install-sqlc: unsupported platform $(uname -s)/$(uname -m)" >&2; exit 1 ;;
esac

manifest_values=$(python3 - "$expected_version" "$platform_key" "$repo_root/tools/database-toolchain.json" <<'PY'
import json
import sys

expected_version, platform, manifest_path = sys.argv[1:]
with open(manifest_path, encoding="utf-8") as stream:
    manifest = json.load(stream)
sqlc = manifest.get("sqlc", {})
entry = sqlc.get("platforms", {}).get(platform, {})
if sqlc.get("version") != expected_version:
    raise SystemExit("sqlc manifest version does not match tools/versions.env")
if not entry.get("url") or not entry.get("sha256"):
    raise SystemExit(f"sqlc manifest has no complete {platform} entry")
print(entry["url"])
print(entry["sha256"])
PY
)
sqlc_url=$(printf '%s\n' "$manifest_values" | sed -n '1p')
sqlc_sha=$(printf '%s\n' "$manifest_values" | sed -n '2p')
archive=$(mktemp "${TMPDIR:-/tmp}/loomhelm-sqlc.XXXXXX.tar.gz")
cleanup() {
	status=$?
	rm -f -- "$archive"
	exit "$status"
}
trap cleanup EXIT HUP INT TERM

curl --fail --silent --show-error --location "$sqlc_url" --output "$archive"
if command -v sha256sum >/dev/null 2>&1; then
	printf '%s  %s\n' "$sqlc_sha" "$archive" | sha256sum -c -
else
	printf '%s  %s\n' "$sqlc_sha" "$archive" | shasum -a 256 -c -
fi
tar -xzf "$archive" -C "$output_dir" sqlc
chmod 0755 "$output_dir/sqlc"
actual_version=$($output_dir/sqlc version 2>/dev/null | awk 'NR == 1 { print $1 }' | sed 's/^v//')
test "$actual_version" = "$expected_version" || {
	echo "install-sqlc: downloaded sqlc version mismatch: expected $expected_version, found ${actual_version:-unreadable}" >&2
	exit 1
}
echo "install-sqlc: installed sqlc $actual_version at $output_dir/sqlc"
