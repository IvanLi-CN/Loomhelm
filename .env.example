LOOMHELM_VERSION=dev
LOOMHELM_CANDIDATE_SOURCE_SHA=dev
LOOMHELM_ARTIFACT_DIGEST=unknown
LOOMHELM_HTTP_ADDR=127.0.0.1:8080
LOOMHELM_DRAIN_TOKEN=dev-drain-token
LOOMHELM_SHUTDOWN_TIMEOUT=10s
LOOMHELM_STARTUP_TIMEOUT=30s
LOOMHELM_WORKER_GENERATION=1
LOOMHELM_WORKER_LEASE_KEY=loomhelm-worker
LOOMHELM_WORKER_HTTP_ADDR=
LOOMHELM_CONNECTOR_SERVER_URL=https://127.0.0.1:8443

LOOMHELM_POSTGRES_DB=loomhelm
LOOMHELM_POSTGRES_USER=loomhelm
LOOMHELM_POSTGRES_PASSWORD=loomhelm_dev_only
# Keep this port synchronized with the port in LOOMHELM_DATABASE_URL.
LOOMHELM_POSTGRES_PORT=55432
LOOMHELM_DATABASE_MIN_CONNS=0
LOOMHELM_DATABASE_MAX_CONNS=4
LOOMHELM_DATABASE_URL=postgres://loomhelm:loomhelm_dev_only@127.0.0.1:55432/loomhelm?sslmode=disable
